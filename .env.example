# Supabase — projet dedie RADAR
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend — envoi du digest quotidien
RESEND_API_KEY=
RADAR_DIGEST_FROM=radar@votre-domaine.fr

# Destinataire UNIQUE du digest.
# Garde-fou legal (spec §1.4, §9.3) : ce logiciel n'envoie jamais d'email
# a un acheteur public. Seule cette adresse peut recevoir quoi que ce soit.
RADAR_DIGEST_TO=agence.celexia@gmail.com
